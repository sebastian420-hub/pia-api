# --- Database (use 'postgres' inside docker compose, '127.0.0.1' from the host) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=pia
DB_PASSWORD=change-me
DB_NAME=pia

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small

# --- API security ---
# Every REST call must send:  Authorization: Bearer <PIA_API_TOKEN>
# The WebSocket sends it as   ws://host/ws/live?token=<PIA_API_TOKEN>
# Generate one with:          python -c "import secrets; print(secrets.token_urlsafe(32))"
PIA_API_TOKEN=
# Comma-separated list of browser origins allowed to call the API
FRONTEND_ORIGINS=http://localhost:5173

# --- Document upload folder (must be the same folder the document_agent watches) ---
DOC_DIR=../pia/data/documents
MAX_UPLOAD_MB=25
